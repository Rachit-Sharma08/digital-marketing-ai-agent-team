node_modules/
dist/
dist-demo/
coverage/
playwright-report/
test-results/
*.tgz
.DS_Store

# Secrets and local settings never enter the repo.
.env
.env.*

# Logs, including the approvals/control-verb audit log (AKG_AUDIT_LOG) if it is pointed inside the tree.
*.log
audit.log*
*.audit.jsonl

# Live screenshots show real Hermes data (task titles, job names); keep them local.
docs/screenshots/live-*.png

# Staff photos and bot headshots never enter the repo: the workspace's characters and photos are the original rights holder's (personal
# use only). They live outside it, in ~/.agents-ka-ghar/portraits and ~/.agents-ka-ghar/headshots
# (AKG_PORTRAITS_DIR, AKG_HEADSHOTS_DIR). Ignore any copy that lands in the tree, and screenshots of the live app
# with photos in them.
portraits/
headshots/
.agents-ka-ghar/
portraits-*.png
