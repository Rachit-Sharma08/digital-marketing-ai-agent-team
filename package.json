{
  "name": "agents-ka-ghar",
  "version": "0.1.0",
  "description": "A local-first AI agent team for digital marketing and vibe-coding, drawn as an isometric office floor plan.",
  "keywords": [
    "hermes",
    "ai-agents",
    "agents",
    "dashboard",
    "isometric",
    "office",
    "local-first"
  ],
  "license": "MIT",
  "author": "Stephen Thorn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rachit-Sharma08/digital-marketing-ai-agent-team.git"
  },
  "bugs": {
    "url": "https://github.com/Rachit-Sharma08/digital-marketing-ai-agent-team/issues"
  },
  "homepage": "https://github.com/Rachit-Sharma08/digital-marketing-ai-agent-team#readme",
  "type": "module",
  "bin": {
    "agents-ka-ghar": "bin/agents-ka-ghar.mjs"
  },
  "files": [
    "bin/",
    "server/src/",
    "server/fixtures/",
    "shared/",
    "!shared/**/*.test.ts",
    "web/dist/",
    "ASSETS-LICENSE",
    "SECURITY.md",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "shared",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @akg/server",
    "dev:web": "npm run dev -w @akg/web --",
    "demo": "npm run build && node bin/agents-ka-ghar.mjs --demo",
    "demo:server": "concurrently -k -n server,web -c yellow,green \"npm run demo -w @akg/server\" \"npm:dev:web\"",
    "build": "npm run build -w @akg/web",
    "build:demo-static": "npm run build:demo-static -w @akg/web",
    "start": "npm run build && npm run serve -w @akg/server",
    "test": "npm run test:web && npm run test:server",
    "test:web": "vitest run",
    "test:server": "npm test -w @akg/server",
    "e2e": "playwright test -c web/playwright.config.ts",
    "e2e:live": "playwright test -c web/playwright.live.config.ts",
    "e2e:auth": "playwright test -c web/playwright.auth.config.ts",
    "e2e:demo": "playwright test -c web/playwright.demo.config.ts",
    "screenshots": "SCREENSHOTS=1 playwright test -c web/playwright.config.ts",
    "portraits:check": "npm run portraits:check -w @akg/server",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && npm run typecheck -w @akg/server",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.5",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
